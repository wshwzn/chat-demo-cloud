# 复制成 .env 后填值；.env 已在 .gitignore 里，不会被提交
# cp .env.example .env

# MySQL root 密码（compose 里的 mysql 容器用）
MYSQL_ROOT_PASSWORD=change-me

# 业务库账号（可选，默认直接用 root 也安全，因为 mysql 容器不对公网暴露）
DB_NAME=chat_demo
DB_USER=chatdemo
DB_PASSWORD=change-me-too

# 后端口令：必须与 nginx 配置里的 proxy_set_header X-Auth-Token 一致
APP_TOKEN=change-me-generate-a-random-string

# 附件存放目录（宿主机路径，挂进容器 /data/upload）
UPLOAD_DIR=./data/upload

# 后端对宿主机暴露的端口，默认只监听本机，由 nginx 反代
BACKEND_PORT=8080